<Window x:Class="InternetMeter.Views.DataCapConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:InternetMeter.Converters"
        mc:Ignorable="d"
        Title="Monthly Data Cap &amp; Hotspot Quota Settings"
        Width="480"
        Height="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <!-- Preset Pill Button Style -->
        <Style x:Key="PresetPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A2035"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A3450"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#0D1117"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#34D399"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E2436"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#293047"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Card Container -->
    <Border Background="#0D0F18"
            BorderBrush="#252B3E"
            BorderThickness="1"
            CornerRadius="10"
            Margin="10"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.85"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Settings Content -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Border Grid.Row="0"
                    Background="#131724"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#1E2436"
                    CornerRadius="10,10,0,0"
                    Padding="14,10"
                    MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Monthly Data Cap &amp; Hotspot Quota" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Click="CloseButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#94A3B8"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Padding="6,2"
                            ToolTip="Close (Esc)">
                        <TextBlock Text="✕"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Settings Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,12,16,10">
                <StackPanel>
                    <!-- Enable Toggle -->
                    <Border Background="#161A2B" BorderBrush="#242B42" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Enable Monthly Data Cap Tracking" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Monitors cumulative bandwidth against monthly allowance" Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Section: Allowance -->
                    <TextBlock Text="DATA ALLOWANCE (CAP)" Foreground="#38BDF8" FontWeight="Bold" FontSize="10.5" Margin="0,0,0,6"/>
                    <Border Background="#121524" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Monthly Quota Limit:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding DataCapGigabytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75" Background="#1A2035" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,3" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="GB" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>

                            <!-- Quick Presets -->
                            <TextBlock Text="Quick Presets:" Foreground="#64748B" FontSize="10" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <Button Style="{StaticResource PresetPillStyle}" Content="25 GB" Command="{Binding SetPresetCommand}" CommandParameter="25"/>
                                <Button Style="{StaticResource PresetPillStyle}" Content="50 GB" Command="{Binding SetPresetCommand}" CommandParameter="50"/>
                                <Button Style="{StaticResource PresetPillStyle}" Content="100 GB" Command="{Binding SetPresetCommand}" CommandParameter="100"/>
                                <Button Style="{StaticResource PresetPillStyle}" Content="250 GB" Command="{Binding SetPresetCommand}" CommandParameter="250"/>
                                <Button Style="{StaticResource PresetPillStyle}" Content="500 GB" Command="{Binding SetPresetCommand}" CommandParameter="500"/>
                                <Button Style="{StaticResource PresetPillStyle}" Content="1 TB" Command="{Binding SetPresetCommand}" CommandParameter="1024"/>
                                <Button Style="{StaticResource PresetPillStyle}" Content="2 TB" Command="{Binding SetPresetCommand}" CommandParameter="2048"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section: Billing Cycle Reset -->
                    <TextBlock Text="BILLING CYCLE RESET" Foreground="#38BDF8" FontWeight="Bold" FontSize="10.5" Margin="0,0,0,6"/>
                    <Border Background="#121524" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cycle Start Day of Month:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding BillingCycleResetDay, StringFormat='Day {0}'}" Foreground="#10B981" FontWeight="Bold" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="31" Value="{Binding BillingCycleResetDay, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                            <!-- Cycle Preview Card -->
                            <Border Background="#1A2035" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                <TextBlock Text="{Binding BillingCyclePreviewText}" Foreground="#38BDF8" FontSize="10" FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Section: Toast Notifications & Thresholds -->
                    <TextBlock Text="ACTION CENTER NOTIFICATIONS" Foreground="#38BDF8" FontWeight="Bold" FontSize="10.5" Margin="0,0,0,6"/>
                    <Border Background="#121524" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Content="Show Windows Action Center Toast Notifications" IsChecked="{Binding EnableToastNotifications, Mode=TwoWay}" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Warning Notification Threshold:" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding WarningThresholdPercent, StringFormat='{}{0:F0}%'}" Foreground="#F59E0B" FontWeight="Bold" FontFamily="Consolas" FontSize="11"/>
                            </Grid>
                            <Slider Minimum="50" Maximum="90" Value="{Binding WarningThresholdPercent, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Critical Notification Threshold:" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CriticalThresholdPercent, StringFormat='{}{0:F0}%'}" Foreground="#F43F5E" FontWeight="Bold" FontFamily="Consolas" FontSize="11"/>
                            </Grid>
                            <Slider Minimum="85" Maximum="99" Value="{Binding CriticalThresholdPercent, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Text if any -->
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontSize="10.5" Margin="2,0,0,4" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer Actions -->
            <Border Grid.Row="2"
                    Background="#131724"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#1E2436"
                    CornerRadius="0,0,10,10"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Reset Alerts"
                            Command="{Binding ResetAlertsCommand}"
                            ToolTip="Clears alert state so notifications can re-trigger for testing"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Save &amp; Apply"
                                Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
