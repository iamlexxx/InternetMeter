<Window x:Class="InternetMeter.Views.BandwidthAnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:InternetMeter.Converters"
        mc:Ignorable="d"
        Title="Detailed Bandwidth Analytics — InternetMeter"
        Width="780"
        Height="540"
        MinWidth="640"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <!-- Tab Pill Button Style -->
        <Style x:Key="TabPillStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2337"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass Action Button Style -->
        <Style x:Key="GlassActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E2337"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A3047"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A3047"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Style -->
        <Style x:Key="TitleBarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Card with Shadow & Border -->
    <Border x:Name="OuterCard"
            Background="#0D0F18"
            BorderBrush="{Binding CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Hero Metric Cards -->
                <RowDefinition Height="*"/>    <!-- Vector Chart Canvas -->
                <RowDefinition Height="Auto"/> <!-- Bottom Actions & Status -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Grid Grid.Row="0"
                  Background="#121522"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Title Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="📈" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Detailed Bandwidth Analytics"
                               Foreground="#F8FAFC"
                               FontWeight="Bold"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="— 60-Minute Rolling Inspector"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center Timeframe Pills -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#0D0F1A"
                        BorderBrush="#1E2337"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="Tab15mBtn"
                                Content="15 Minutes"
                                Style="{StaticResource TabPillStyle}"
                                Click="Tab15m_Click"/>
                        <Button x:Name="Tab30mBtn"
                                Content="30 Minutes"
                                Style="{StaticResource TabPillStyle}"
                                Click="Tab30m_Click"/>
                        <Button x:Name="Tab60mBtn"
                                Content="60 Minutes"
                                Style="{StaticResource TabPillStyle}"
                                Click="Tab60m_Click"/>
                    </StackPanel>
                </Border>

                <!-- Right Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource TitleBarBtnStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <TextBlock Text="─" FontSize="11" Foreground="#94A3B8"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarBtnStyle}" Click="CloseButton_Click" ToolTip="Close (Esc)">
                        <TextBlock Text="✕" FontSize="11" Foreground="#94A3B8"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Hero Metric Cards Strip -->
            <Grid Grid.Row="1" Margin="14,12,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Peak Download Card -->
                <Border Grid.Column="0" Background="#121522" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="PEAK DOWNLOAD" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PeakDownloadText}" Foreground="{Binding DownloadBrush}" FontSize="17" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Consolas" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding PeakDownloadSubtext}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Peak Upload Card -->
                <Border Grid.Column="1" Background="#121522" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="PEAK UPLOAD" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PeakUploadText}" Foreground="{Binding UploadBrush}" FontSize="17" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Consolas" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding PeakUploadSubtext}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Window Volume Card -->
                <Border Grid.Column="2" Background="#121522" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL VOLUME" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalVolumeText}" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Consolas" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding TotalVolumeSubtext}" Foreground="#94A3B8" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Average Rate Card -->
                <Border Grid.Column="3" Background="#121522" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="AVERAGE THROUGHPUT" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AverageRateText}" Foreground="#6366F1" FontSize="17" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Consolas" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding AverageRateSubtext}" Foreground="#94A3B8" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Vector Chart Canvas & Scrubber Area -->
            <Grid Grid.Row="2" Margin="14,4,14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Y-Axis Labels Column -->
                <Grid Grid.Column="0" Margin="0,4,8,22">
                    <TextBlock Text="{Binding YAxisLabel100}" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="#64748B" FontSize="9.5" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding YAxisLabel75}" VerticalAlignment="Center" Margin="0,-68,0,0" HorizontalAlignment="Right" Foreground="#475569" FontSize="9" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding YAxisLabel50}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#475569" FontSize="9" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding YAxisLabel25}" VerticalAlignment="Center" Margin="0,68,0,0" HorizontalAlignment="Right" Foreground="#475569" FontSize="9" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding YAxisLabel0}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="#64748B" FontSize="9.5" FontFamily="Consolas"/>
                </Grid>

                <!-- Main Vector Plot Viewport -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <!-- Chart Border & Plot Canvas -->
                    <Border Grid.Row="0"
                            x:Name="PlotBorder"
                            Background="#090B12"
                            BorderBrush="#1E2337"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True"
                            MouseMove="PlotCanvas_MouseMove"
                            MouseLeave="PlotCanvas_MouseLeave"
                            Cursor="Cross">
                        <Grid>
                            <!-- Horizontal Grid Lines -->
                            <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Line X1="0" Y1="0" X2="{Binding ActualWidth, ElementName=PlotBorder}" Y2="0" Stroke="#161B29" StrokeThickness="1"/>
                                <Line X1="0" Y1="{Binding ActualHeight, ElementName=PlotBorder, Converter={x:Static conv:MultiplyConverter.Instance}, ConverterParameter=0.25}" X2="{Binding ActualWidth, ElementName=PlotBorder}" Y2="{Binding ActualHeight, ElementName=PlotBorder, Converter={x:Static conv:MultiplyConverter.Instance}, ConverterParameter=0.25}" Stroke="#161B29" StrokeDashArray="3 3" StrokeThickness="1"/>
                                <Line X1="0" Y1="{Binding ActualHeight, ElementName=PlotBorder, Converter={x:Static conv:MultiplyConverter.Instance}, ConverterParameter=0.50}" X2="{Binding ActualWidth, ElementName=PlotBorder}" Y2="{Binding ActualHeight, ElementName=PlotBorder, Converter={x:Static conv:MultiplyConverter.Instance}, ConverterParameter=0.50}" Stroke="#161B29" StrokeDashArray="3 3" StrokeThickness="1"/>
                                <Line X1="0" Y1="{Binding ActualHeight, ElementName=PlotBorder, Converter={x:Static conv:MultiplyConverter.Instance}, ConverterParameter=0.75}" X2="{Binding ActualWidth, ElementName=PlotBorder}" Y2="{Binding ActualHeight, ElementName=PlotBorder, Converter={x:Static conv:MultiplyConverter.Instance}, ConverterParameter=0.75}" Stroke="#161B29" StrokeDashArray="3 3" StrokeThickness="1"/>
                            </Canvas>

                            <!-- Geometry Canvas -->
                            <Canvas x:Name="GraphCanvas"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <!-- Area Fills Under Curves -->
                                <Path x:Name="DownloadAreaPath" Fill="{Binding DownloadAreaBrush}"/>
                                <Path x:Name="UploadAreaPath" Fill="{Binding UploadAreaBrush}"/>

                                <!-- Vector Strokes -->
                                <Path x:Name="DownloadPath" Stroke="{Binding DownloadBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                <Path x:Name="UploadPath" Stroke="{Binding UploadBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>

                                <!-- Scrubber Vertical Crosshair -->
                                <Line x:Name="CrosshairLine"
                                      Stroke="#94A3B8"
                                      StrokeThickness="1"
                                      StrokeDashArray="3 2"
                                      Visibility="Collapsed"/>

                                <!-- Anchor Point Dots -->
                                <Ellipse x:Name="DlDot" Width="8" Height="8" Fill="{Binding DownloadBrush}" Stroke="#0D0F18" StrokeThickness="1.5" Visibility="Collapsed"/>
                                <Ellipse x:Name="UlDot" Width="8" Height="8" Fill="{Binding UploadBrush}" Stroke="#0D0F18" StrokeThickness="1.5" Visibility="Collapsed"/>

                                <!-- Floating Glass Inspection Tooltip -->
                                <Border x:Name="TooltipBorder"
                                        Background="#161928"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,5"
                                        Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.8"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock x:Name="TooltipTimeText" Text="12:45:10" Foreground="#F8FAFC" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock x:Name="TooltipDlText" Text="↓ 52.4 MB/s" Foreground="{Binding DownloadBrush}" FontSize="10.5" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TooltipUlText" Text="↑ 14.1 MB/s" Foreground="{Binding UploadBrush}" FontSize="10.5" FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TooltipAppText" Text="brave.exe (48.1 MB/s)" Foreground="#94A3B8" FontSize="9.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- X-Axis Timeline Markers -->
                    <Grid Grid.Row="1" Margin="2,4,2,0">
                        <TextBlock x:Name="XAxisStartLabel" Text="-60m" HorizontalAlignment="Left" Foreground="#64748B" FontSize="9.5" FontFamily="Consolas"/>
                        <TextBlock x:Name="XAxisQuarterLabel" Text="-45m" HorizontalAlignment="Center" Margin="-200,0,0,0" Foreground="#475569" FontSize="9" FontFamily="Consolas"/>
                        <TextBlock x:Name="XAxisMidLabel" Text="-30m" HorizontalAlignment="Center" Foreground="#475569" FontSize="9" FontFamily="Consolas"/>
                        <TextBlock x:Name="XAxisThreeQuarterLabel" Text="-15m" HorizontalAlignment="Center" Margin="200,0,0,0" Foreground="#475569" FontSize="9" FontFamily="Consolas"/>
                        <TextBlock Text="Now" HorizontalAlignment="Right" Foreground="#64748B" FontSize="9.5" FontWeight="SemiBold" FontFamily="Consolas"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 4. Bottom Footer Actions & Status -->
            <Grid Grid.Row="3" Background="#121522" Height="40" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Legend & Sample Count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="7" Height="7" Fill="{Binding DownloadBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Download" Foreground="#94A3B8" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <Ellipse Width="7" Height="7" Fill="{Binding UploadBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Upload" Foreground="#94A3B8" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding SampleCountText}" Foreground="#64748B" FontSize="10.5" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="ExportNoticeText"
                               Text="Saved to Downloads!"
                               Foreground="#10B981"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="Collapsed"/>
                    <Button Content="Export CSV..."
                            Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding ExportCsvCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
