<Window x:Class="InternetMeter.Views.UsageReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:InternetMeter.Models"
        mc:Ignorable="d"
        Title="Application Data Usage Report — InternetMeter"
        Width="640"
        Height="540"
        MinWidth="540"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Dark scrollbar style -->
        <SolidColorBrush x:Key="StandardBorderBrush" Color="#1E2337"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#2A3047"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#121522"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#161A2B"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="EmeraldBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="SkyBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="IndigoBrush" Color="#6366F1"/>

        <!-- Pill Button Style -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2337"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E2337"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A3047"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A3047"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Card with Glow & Shadow -->
    <Border Background="#0D0F18"
            BorderBrush="#252B42"
            BorderThickness="1"
            CornerRadius="12"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header / Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Controls Bar (Tabs + Search) -->
                <RowDefinition Height="Auto"/> <!-- Summary Cards -->
                <RowDefinition Height="*"/>    <!-- Data Grid -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Grid Grid.Row="0"
                  Background="#121522"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Application Data Usage Report"
                               Foreground="#F8FAFC"
                               FontWeight="Bold"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="— InternetMeter"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Close Window Button -->
                <Button Grid.Column="1"
                        Content="✕"
                        Foreground="#94A3B8"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="44"
                        Height="44"
                        FontSize="14"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        ToolTip="Close Report (Esc)">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 2. Controls Bar: Timeframe Tabs + Search Filter -->
            <Border Grid.Row="1"
                    Background="#0F121F"
                    BorderBrush="#1E2337"
                    BorderThickness="0,1,0,1"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Timeframe Segmented Selector -->
                    <Border Grid.Column="0"
                            Background="#161A2B"
                            BorderBrush="#1E2337"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabSessionBtn"
                                    Content="Current Session"
                                    Style="{StaticResource TabButtonStyle}"
                                    Click="TabSession_Click"/>
                            <Button x:Name="TabTodayBtn"
                                    Content="Today (24h)"
                                    Style="{StaticResource TabButtonStyle}"
                                    Click="TabToday_Click"/>
                            <Button x:Name="TabMonthBtn"
                                    Content="This Month"
                                    Style="{StaticResource TabButtonStyle}"
                                    Click="TabMonth_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Search Input Box -->
                    <Border Grid.Column="2"
                            Background="#161A2B"
                            BorderBrush="#252B42"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="🔍"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="2,0,6,0"/>

                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     Foreground="#F8FAFC"
                                     BorderThickness="0"
                                     CaretBrush="#38BDF8"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"/>

                            <!-- Placeholder Hint -->
                            <TextBlock x:Name="SearchPlaceholder"
                                       Grid.Column="1"
                                       Text="Filter apps..."
                                       Foreground="#64748B"
                                       FontSize="12"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"/>

                            <!-- Clear Button -->
                            <Button x:Name="ClearSearchBtn"
                                    Grid.Column="2"
                                    Content="✕"
                                    Foreground="#64748B"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="10"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="ClearSearch_Click"
                                    VerticalAlignment="Center"
                                    Margin="4,0,2,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Summary Stats Banner -->
            <Border Grid.Row="2"
                    Background="#121522"
                    BorderBrush="#1E2337"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Data Card -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL TRACKED" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryTotalText" Text="0 B" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Download Card -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="DOWNLOAD" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryDlText" Text="↓ 0 B" Foreground="#10B981" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Upload Card -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="UPLOAD" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryUlText" Text="↑ 0 B" Foreground="#38BDF8" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Active Apps Count Card -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="APPLICATIONS" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryAppsText" Text="0 active · 0 closed" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Records Data Grid -->
            <Grid Grid.Row="3" Background="#0D0F18">
                <DataGrid x:Name="RecordsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1A1E2F"
                          Background="#0D0F18"
                          RowBackground="#0D0F18"
                          AlternatingRowBackground="#111420"
                          BorderThickness="0"
                          Foreground="#F8FAFC"
                          HeadersVisibility="Column"
                          MouseDoubleClick="RecordsGrid_MouseDoubleClick">

                    <DataGrid.Resources>
                        <!-- Column Header Style -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#121522"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#1E2337"/>
                        </Style>

                        <!-- Cell Style -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E253B"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Application (Icon + Name + Status Dot) -->
                        <DataGridTemplateColumn Header="Application" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- App Icon -->
                                        <Image Source="{Binding Icon}"
                                               Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <Trigger Property="Source" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- Name -->
                                        <TextBlock Text="{Binding ProcessName}"
                                                   Foreground="#F8FAFC"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>

                                        <!-- Status Indicator Badge -->
                                        <Border CornerRadius="4"
                                                Padding="4,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#142823"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#1E2337"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="9" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="ACTIVE"/>
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="CLOSED"/>
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Download Column -->
                        <DataGridTemplateColumn Header="Download" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedTotalDownload}"
                                               Foreground="#10B981"
                                               FontFamily="Consolas"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Upload Column -->
                        <DataGridTemplateColumn Header="Upload" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedTotalUpload}"
                                               Foreground="#38BDF8"
                                               FontFamily="Consolas"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Total Column -->
                        <DataGridTemplateColumn Header="Total" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedTotal}"
                                               Foreground="#F8FAFC"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Share Progress Bar Column -->
                        <DataGridTemplateColumn Header="Share" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ProgressBar Value="{Binding PercentageOfTotal, Mode=OneWay}"
                                                     Maximum="100"
                                                     Height="6"
                                                     Background="#1A1E2F"
                                                     Foreground="#6366F1"
                                                     BorderThickness="0"/>
                                        <TextBlock Text="{Binding PercentageOfTotal, StringFormat={}{0:F0}%}"
                                                   Foreground="#94A3B8"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,8,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Message -->
                <TextBlock x:Name="EmptyStateText"
                           Text="No application traffic recorded for this timeframe."
                           Foreground="#64748B"
                           FontSize="12"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- 5. Footer Actions -->
            <Border Grid.Row="4"
                    Background="#121522"
                    BorderBrush="#1E2337"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="↻ Reset Session"
                            Style="{StaticResource GlassActionButtonStyle}"
                            Click="ResetSession_Click"
                            ToolTip="Clears accumulated data for the active session (historical days preserved)"/>

                    <TextBlock Grid.Column="1"
                               Text="Double-click row to open file in Explorer"
                               Foreground="#64748B"
                               FontSize="11"
                               FontStyle="Italic"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="📥 Export CSV..."
                            Style="{StaticResource GlassActionButtonStyle}"
                            Click="ExportCsv_Click"
                            Margin="0,0,10,0"
                            ToolTip="Export records to CSV spreadsheet file"/>

                    <Button Grid.Column="3"
                            Content="Close"
                            Style="{StaticResource GlassActionButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

