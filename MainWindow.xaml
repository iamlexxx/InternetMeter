<Window x:Class="InternetMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:InternetMeter.ViewModels"
        xmlns:models="clr-namespace:InternetMeter.Models"
        xmlns:conv="clr-namespace:InternetMeter.Converters"
        mc:Ignorable="d"
        Title="InternetMeter"
        Width="274"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding AlwaysOnTop}"
        Opacity="{Binding CurrentOpacity}"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:EqualityToBooleanConverter x:Key="EqualityToBool" />
        <conv:OpacityToBooleanConverter x:Key="OpacityToBool" />
        <conv:ConnectionStatusColorConverter x:Key="ConnColorConv" />

        <!-- Network Health Diagnostics Flyout ToolTip Style -->
        <Style x:Key="NetworkHealthToolTipStyle" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Content" Value="NetworkHealthDiagnostics"/>
            <Setter Property="DataContext" Value="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#121522"
                                BorderBrush="#2A3047"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85"/>
                            </Border.Effect>
                            <StackPanel MinWidth="250">
                                <!-- Header -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎮" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Network Health Diagnostics" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NetworkQualityGradeText}" Foreground="{Binding NetworkQualityGradeColorHex}" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </Grid>

                                <Separator Height="1" Background="#1E2436" Margin="0,0,0,8"/>

                                <!-- Metrics Table -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Current Latency -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Latency:" Foreground="#64748B" FontSize="10.5" Margin="0,1.5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LatencyText}" Foreground="{Binding LatencyColorHex}" FontWeight="SemiBold" FontSize="10.5" FontFamily="Consolas" Margin="0,1.5"/>

                                    <!-- Row 1: Min / Max / Avg -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Min / Max (Avg):" Foreground="#64748B" FontSize="10.5" Margin="0,1.5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatencyMinMaxText}" Foreground="#94A3B8" FontSize="10.5" FontFamily="Consolas" Margin="0,1.5"/>

                                    <!-- Row 2: Jitter -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Jitter (Variance):" Foreground="#64748B" FontSize="10.5" Margin="0,1.5"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,1.5">
                                        <TextBlock Text="{Binding JitterText}" Foreground="{Binding JitterColorHex}" FontWeight="SemiBold" FontSize="10.5" FontFamily="Consolas" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding JitterRatingText}" Foreground="{Binding JitterColorHex}" FontSize="9.5" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Row 3: Packet Loss -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Packet Loss:" Foreground="#64748B" FontSize="10.5" Margin="0,1.5"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PacketLossText}" Foreground="{Binding PacketLossColorHex}" FontWeight="SemiBold" FontSize="10.5" FontFamily="Consolas" Margin="0,1.5"/>

                                    <!-- Row 4: Bufferbloat -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Bufferbloat:" Foreground="#64748B" FontSize="10.5" Margin="0,1.5"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BufferbloatStatusText}" Foreground="{Binding BufferbloatColorHex}" FontSize="10" Margin="0,1.5" TextTrimming="CharacterEllipsis"/>

                                    <!-- Row 5: Target Host -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Target Host:" Foreground="#64748B" FontSize="10.5" Margin="0,1.5"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TargetHostText}" Foreground="#94A3B8" FontSize="10" FontFamily="Consolas" Margin="0,1.5"/>
                                </Grid>

                                <Separator Height="1" Background="#1E2436" Margin="0,4,0,6"/>

                                <!-- Footer Summary -->
                                <TextBlock Text="{Binding HealthSummaryText}" Foreground="{Binding NetworkQualityGradeColorHex}" FontSize="10" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monthly Data Cap & Hotspot Quota Flyout ToolTip Style -->
        <Style x:Key="DataCapToolTipStyle" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Content" Value="DataCapDiagnostics"/>
            <Setter Property="DataContext" Value="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#121522"
                                BorderBrush="#2A3047"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85"/>
                            </Border.Effect>
                            <StackPanel MinWidth="260">
                                <!-- Header -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Monthly Data Cap &amp; Quota" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DataCapStatusText}" Foreground="{Binding DataCapProgressColorHex}" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </Grid>

                                <Separator Height="1" Background="#1E2436" Margin="0,0,0,8"/>

                                <!-- Metrics Table -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Active Cycle -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Cycle Window:" Foreground="#64748B" FontSize="10.5" Margin="0,1.5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataCapDaysLeftText}" Foreground="#94A3B8" FontSize="10.5" FontFamily="Consolas" Margin="0,1.5"/>

                                    <!-- Row 1: Consumed -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Data Consumed:" Foreground="#64748B" FontSize="10.5" Margin="0,1.5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataCapUsageText}" Foreground="{Binding DataCapProgressColorHex}" FontWeight="SemiBold" FontSize="10.5" FontFamily="Consolas" Margin="0,1.5"/>

                                    <!-- Row 2: Remaining -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Allowance Left:" Foreground="#64748B" FontSize="10.5" Margin="0,1.5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentQuota.FormattedRemaining}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="10.5" FontFamily="Consolas" Margin="0,1.5"/>

                                    <!-- Row 3: Top Consumer -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Top Consumer:" Foreground="#64748B" FontSize="10.5" Margin="0,1.5"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentQuota.TopConsumerProcess}" Foreground="#38BDF8" FontSize="10.5" FontFamily="Consolas" Margin="0,1.5" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Separator Height="1" Background="#1E2436" Margin="0,4,0,6"/>

                                <!-- Footer Tip -->
                                <TextBlock Text="Click to configure quota allowance &amp; cycle reset day" Foreground="#64748B" FontSize="9.5" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme Separator -->
        <Style TargetType="{x:Type Separator}">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#2A2F45" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme ContextMenu Root Container -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="#161822"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SubmenuItem Template (Regular clickable menu item) -->
        <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="6,5" Margin="1" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" SharedSizeGroup="MenuItemIconColumnGroup"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup"/>
                    </Grid.ColumnDefinitions>

                    <!-- Checkmark / Custom Icon Container -->
                    <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="CheckMarkBox" Width="15" Height="15" CornerRadius="3" Background="#1E2436" Visibility="Collapsed">
                            <TextBlock Text="✓" Foreground="#10B981" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16"/>
                    </Grid>

                    <!-- Text Header -->
                    <ContentPresenter Grid.Column="1"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      Margin="6,0,12,0"/>

                    <!-- Shortcut Gesture -->
                    <TextBlock Grid.Column="2"
                               Text="{TemplateBinding InputGestureText}"
                               Foreground="#64748B"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMarkBox" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#262B3D"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- SubmenuHeader Template (Menu item with flyout submenus) -->
        <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="6,5" Margin="1" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" SharedSizeGroup="MenuItemIconColumnGroup"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup"/>
                        <ColumnDefinition Width="14"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <ContentPresenter Grid.Column="0" x:Name="Icon" ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Header Content -->
                    <ContentPresenter Grid.Column="1"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      Margin="6,0,12,0"/>

                    <!-- Submenu Indicator Arrow -->
                    <Path Grid.Column="3"
                          Data="M 0 0 L 4 4 L 0 8 Z"
                          Fill="#94A3B8"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="0,0,2,0"/>

                    <!-- Explicitly Styled Dark Submenu Popup -->
                    <Popup x:Name="PART_Popup"
                           AllowsTransparency="True"
                           Placement="Right"
                           VerticalOffset="-4"
                           HorizontalOffset="2"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Focusable="False"
                           PopupAnimation="Fade">
                        <Border Background="#161822"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
                            </Border.Effect>
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#262B3D"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#202434"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Top-level MenuItem Style applying SubmenuItem & SubmenuHeader templates -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main Widget Container -->
    <Border x:Name="WidgetCard"
            Background="{Binding CardBackgroundBrush}"
            CornerRadius="10"
            BorderBrush="{Binding CardBorderBrush}"
            BorderThickness="1"
            Margin="6"
            MouseLeftButtonDown="WidgetCard_MouseLeftButtonDown">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
        </Border.LayoutTransform>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="10,8"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                        <Setter Property="Padding" Value="6,4"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Border.ContextMenu>
            <ContextMenu x:Name="MainContextMenu" Opened="ContextMenu_Opened">
                <MenuItem Header="Always on Top" IsCheckable="True" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"/>
                <Separator/>
                <MenuItem Header="Speed Unit">
                    <MenuItem Header="MBps (MB/s)" Click="MenuUnit_MBps_Click" IsCheckable="True" IsChecked="{Binding CurrentUnit, Converter={StaticResource EqualityToBool}, ConverterParameter=MBps, Mode=OneWay}" />
                    <MenuItem Header="Mbps (Megabits)" Click="MenuUnit_Mbps_Click" IsCheckable="True" IsChecked="{Binding CurrentUnit, Converter={StaticResource EqualityToBool}, ConverterParameter=Mbps, Mode=OneWay}" />
                    <MenuItem Header="KBps (KB/s)" Click="MenuUnit_KBps_Click" IsCheckable="True" IsChecked="{Binding CurrentUnit, Converter={StaticResource EqualityToBool}, ConverterParameter=KBps, Mode=OneWay}" />
                    <MenuItem Header="Kbps (Kilobits)" Click="MenuUnit_Kbps_Click" IsCheckable="True" IsChecked="{Binding CurrentUnit, Converter={StaticResource EqualityToBool}, ConverterParameter=Kbps, Mode=OneWay}" />
                </MenuItem>
                <MenuItem Header="Network Adapter" x:Name="AdaptersMenu" Click="AdaptersMenu_Click">
                    <MenuItem Header="Loading..." IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Theme">
                    <MenuItem Header="Emerald &amp; Sky (Default)" Click="MenuTheme_EmeraldSky_Click" IsCheckable="True" IsChecked="{Binding CurrentTheme, Converter={StaticResource EqualityToBool}, ConverterParameter=EmeraldSky, Mode=OneWay}"/>
                    <MenuItem Header="Cyberpunk Neon" Click="MenuTheme_CyberpunkNeon_Click" IsCheckable="True" IsChecked="{Binding CurrentTheme, Converter={StaticResource EqualityToBool}, ConverterParameter=CyberpunkNeon, Mode=OneWay}"/>
                    <MenuItem Header="Monochrome Stealth" Click="MenuTheme_MonochromeStealth_Click" IsCheckable="True" IsChecked="{Binding CurrentTheme, Converter={StaticResource EqualityToBool}, ConverterParameter=MonochromeStealth, Mode=OneWay}"/>
                    <MenuItem Header="Solar Amber" Click="MenuTheme_SolarAmber_Click" IsCheckable="True" IsChecked="{Binding CurrentTheme, Converter={StaticResource EqualityToBool}, ConverterParameter=SolarAmber, Mode=OneWay}"/>
                </MenuItem>
                <MenuItem Header="Scale">
                    <MenuItem Header="85% (Compact)" Click="MenuScale_85_Click" IsCheckable="True" IsChecked="{Binding UiScale, Converter={StaticResource OpacityToBool}, ConverterParameter=0.85, Mode=OneWay}"/>
                    <MenuItem Header="100% (Standard)" Click="MenuScale_100_Click" IsCheckable="True" IsChecked="{Binding UiScale, Converter={StaticResource OpacityToBool}, ConverterParameter=1.0, Mode=OneWay}"/>
                    <MenuItem Header="125% (Large)" Click="MenuScale_125_Click" IsCheckable="True" IsChecked="{Binding UiScale, Converter={StaticResource OpacityToBool}, ConverterParameter=1.25, Mode=OneWay}"/>
                </MenuItem>
                <MenuItem Header="Windows 11 Frosted Glass (Acrylic)" IsCheckable="True" IsChecked="{Binding EnableAcrylicBlur, Mode=TwoWay}"/>
                <MenuItem Header="Opacity">
                    <MenuItem Header="100%" Click="MenuOpacity_100_Click" IsCheckable="True" IsChecked="{Binding WindowOpacity, Converter={StaticResource OpacityToBool}, ConverterParameter=1.0, Mode=OneWay}"/>
                    <MenuItem Header="80%" Click="MenuOpacity_80_Click" IsCheckable="True" IsChecked="{Binding WindowOpacity, Converter={StaticResource OpacityToBool}, ConverterParameter=0.8, Mode=OneWay}"/>
                    <MenuItem Header="60%" Click="MenuOpacity_60_Click" IsCheckable="True" IsChecked="{Binding WindowOpacity, Converter={StaticResource OpacityToBool}, ConverterParameter=0.6, Mode=OneWay}"/>
                    <MenuItem Header="40%" Click="MenuOpacity_40_Click" IsCheckable="True" IsChecked="{Binding WindowOpacity, Converter={StaticResource OpacityToBool}, ConverterParameter=0.4, Mode=OneWay}"/>
                </MenuItem>
                <MenuItem Header="Show Ping Latency" IsCheckable="True" IsChecked="{Binding ShowPingLatency, Mode=TwoWay}"/>
                <MenuItem Header="Show Sparkline" IsCheckable="True" IsChecked="{Binding ShowSparkline, Mode=TwoWay}"/>
                <MenuItem Header="Show Session Stats" IsCheckable="True" IsChecked="{Binding ShowFooter, Mode=TwoWay}"/>
                <MenuItem Header="Process Inspector (Top Apps)" InputGestureText="Ctrl+Shift+P" IsCheckable="True" IsChecked="{Binding IsProcessInspectorExpanded, Mode=TwoWay}"/>
                <MenuItem Header="Traffic Usage Report..." InputGestureText="Ctrl+Shift+R" Command="{Binding OpenUsageReportCommand}"/>
                <MenuItem Header="Detailed Bandwidth Analytics..." InputGestureText="Ctrl+Shift+A" Command="{Binding OpenAnalyticsCommand}"/>
                <MenuItem Header="Monthly Data Cap &amp; Quota...">
                    <MenuItem Header="Enable Data Cap" IsCheckable="True" IsChecked="{Binding IsDataCapEnabled, Mode=TwoWay}"/>
                    <MenuItem Header="Configure Quota &amp; Cycle..." Command="{Binding OpenDataCapConfigCommand}"/>
                    <Separator/>
                    <MenuItem Header="50 GB Preset" Click="MenuDataCap_50_Click" IsCheckable="True" IsChecked="{Binding DataCapGigabytes, Converter={StaticResource OpacityToBool}, ConverterParameter=50, Mode=OneWay}"/>
                    <MenuItem Header="100 GB Preset" Click="MenuDataCap_100_Click" IsCheckable="True" IsChecked="{Binding DataCapGigabytes, Converter={StaticResource OpacityToBool}, ConverterParameter=100, Mode=OneWay}"/>
                    <MenuItem Header="250 GB Preset" Click="MenuDataCap_250_Click" IsCheckable="True" IsChecked="{Binding DataCapGigabytes, Converter={StaticResource OpacityToBool}, ConverterParameter=250, Mode=OneWay}"/>
                    <MenuItem Header="500 GB Preset" Click="MenuDataCap_500_Click" IsCheckable="True" IsChecked="{Binding DataCapGigabytes, Converter={StaticResource OpacityToBool}, ConverterParameter=500, Mode=OneWay}"/>
                    <MenuItem Header="1 TB Preset" Click="MenuDataCap_1000_Click" IsCheckable="True" IsChecked="{Binding DataCapGigabytes, Converter={StaticResource OpacityToBool}, ConverterParameter=1024, Mode=OneWay}"/>
                </MenuItem>
                <MenuItem Header="Compact Ribbon Mode" InputGestureText="Ctrl+Shift+D" IsCheckable="True" IsChecked="{Binding IsCompactMode, Mode=TwoWay}"/>
                <MenuItem Header="Click-Through (Ghost Mode)" InputGestureText="Ctrl+Shift+G" IsCheckable="True" IsChecked="{Binding IsGhostMode, Mode=TwoWay}"/>
                <Separator/>
                <MenuItem Header="Start with Windows" IsCheckable="True" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                <Separator/>
                <MenuItem Header="Reset Position" Command="{Binding ResetPositionCommand}"/>
                <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- 1. Full HUD Panel -->
            <StackPanel x:Name="FullWidgetPanel"
                        Visibility="{Binding IsCompactMode, Converter={StaticResource InverseBoolToVis}}">
                <!-- Top Controls Header -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="96"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Adapter Name / Status Indicator -->
                <Button Grid.Column="0" 
                        Style="{StaticResource GlassButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="AdapterButton_Click"
                        ToolTip="Click to switch Network Adapter">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,5,0"
                                 Fill="{Binding IsConnected, Converter={StaticResource ConnColorConv}}"/>
                        <TextBlock Text="{Binding SelectedAdapterName}"
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   MaxWidth="80"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>

                <!-- Real-time Latency Heartbeat Badge (Dedicated Unclipped Column) -->
                <Border x:Name="PingBadgeBorder"
                        Grid.Column="1"
                        Background="#1AFFFFFF"
                        CornerRadius="4"
                        Padding="5,1"
                        Margin="4,0,0,0"
                        MinWidth="48"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTipService.InitialShowDelay="50"
                        ToolTipService.ShowDuration="60000"
                        ToolTipService.BetweenShowDelay="0"
                        MouseLeftButtonDown="PingBadge_MouseLeftButtonDown"
                        Visibility="{Binding ShowPingLatency, Converter={StaticResource BoolToVis}}">
                    <Border.ToolTip>
                        <ToolTip Style="{StaticResource NetworkHealthToolTipStyle}" Content="{Binding}"/>
                    </Border.ToolTip>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" 
                                 Fill="{Binding LatencyColorHex}" 
                                 Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding LatencyText}" 
                                   Foreground="{Binding LatencyColorHex}" 
                                   FontSize="10" 
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Consolas, Segoe UI"/>
                        <TextBlock Text=" ⚠"
                                   Foreground="#F59E0B"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Visibility="{Binding HasBufferbloatWarning, Converter={StaticResource BoolToVis}}"
                                   Margin="2,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pin Toggle Button -->
                    <Button Style="{StaticResource GlassButtonStyle}"
                            Command="{Binding ToggleAlwaysOnTopCommand}"
                            ToolTip="Toggle Always on Top"
                            Padding="5,1"
                            Margin="0,0,2,0">
                        <TextBlock Text="📌" FontSize="11" 
                                   Foreground="{Binding AlwaysOnTop, Converter={StaticResource ConnColorConv}}"/>
                    </Button>

                    <!-- Unit Switcher Button -->
                    <Button Style="{StaticResource GlassButtonStyle}"
                            Command="{Binding CycleUnitCommand}"
                            ToolTip="Click to cycle units (KBps, MBps, Kbps, Mbps)"
                            Padding="3,1">
                        <Border Background="#25FFFFFF" CornerRadius="3" Padding="4,1">
                            <TextBlock Text="{Binding UnitLabel}" 
                                       Foreground="#38BDF8" 
                                       FontSize="10" 
                                       FontWeight="Bold"/>
                        </Border>
                    </Button>

                    <!-- Close to Tray Button -->
                    <Button Style="{StaticResource GlassButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close (Right click widget for menu)"
                            Padding="4,1"
                            Margin="2,0,0,0">
                        <TextBlock Text="✕" FontSize="10" Foreground="#64748B"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Download Row -->
            <Grid Margin="0,2,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- DL Label + Value -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="↓" Foreground="{Binding DownloadBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding DownloadSpeedText}" 
                               Foreground="{Binding DownloadBrush}"
                               FontFamily="Segoe UI Variable Display, Consolas, Segoe UI"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UnitLabel}"
                               Foreground="{Binding DownloadBrush}"
                               Opacity="0.85"
                               FontSize="10"
                               FontWeight="Medium"
                               Margin="4,2,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- DL Sparkline Canvas -->
                <Border Grid.Column="2" 
                        Width="70" Height="18" 
                        Visibility="{Binding ShowSparkline, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center">
                    <Canvas Width="70" Height="18">
                        <Polyline Points="{Binding DownloadPoints}"
                                  Stroke="{Binding DownloadBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"/>
                    </Canvas>
                </Border>
            </Grid>

            <!-- Upload Row -->
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- UL Label + Value -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="↑" Foreground="{Binding UploadBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding UploadSpeedText}" 
                               Foreground="{Binding UploadBrush}"
                               FontFamily="Segoe UI Variable Display, Consolas, Segoe UI"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UnitLabel}"
                               Foreground="{Binding UploadBrush}"
                               Opacity="0.85"
                               FontSize="10"
                               FontWeight="Medium"
                               Margin="4,2,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- UL Sparkline Canvas -->
                <Border Grid.Column="2" 
                        Width="70" Height="18" 
                        Visibility="{Binding ShowSparkline, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center">
                    <Canvas Width="70" Height="18">
                        <Polyline Points="{Binding UploadPoints}"
                                  Stroke="{Binding UploadBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"/>
                    </Canvas>
                </Border>
            </Grid>

            <!-- Monthly Data Cap & Quota Gauge (When Enabled) -->
            <Border x:Name="DataCapPanel"
                    Margin="0,5,0,0" 
                    Padding="0,3,0,0"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#1AFFFFFF"
                    Cursor="Hand"
                    ToolTipService.InitialShowDelay="50"
                    ToolTipService.ShowDuration="60000"
                    ToolTipService.BetweenShowDelay="0"
                    MouseLeftButtonDown="DataCapPanel_MouseLeftButtonDown"
                    Visibility="{Binding IsDataCapEnabled, Converter={StaticResource BoolToVis}}">
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource DataCapToolTipStyle}" Content="{Binding}"/>
                </Border.ToolTip>
                <StackPanel>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="{Binding DataCapUsageText}" Foreground="#94A3B8" FontSize="9.5" FontFamily="Consolas, Segoe UI" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding DataCapDaysLeftText}" Foreground="#64748B" FontSize="9.5" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding DataCapProgressPercent, Mode=OneWay}"
                                 Foreground="{Binding DataCapProgressBrush}"
                                 Background="#161B2E"
                                 BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Session Stats Footer -->
            <Border Margin="0,6,0,0" 
                    Padding="0,4,0,0"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#1AFFFFFF"
                    Visibility="{Binding ShowFooter, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <TextBlock Text="{Binding SessionStatsText}"
                               Foreground="#64748B"
                               FontSize="10"
                               FontFamily="Segoe UI, Consolas"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource GlassButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="4,0"
                            Margin="0,-2,0,0"
                            Command="{Binding ToggleProcessInspectorCommand}"
                            ToolTip="Toggle Process Inspector (Ctrl+Shift+P)">
                        <TextBlock Text="{Binding ProcessInspectorToggleGlyph}"
                                   Foreground="#94A3B8"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Collapsible Process Inspector Panel -->
            <Border x:Name="ProcessInspectorPanel"
                    Visibility="{Binding IsProcessInspectorExpanded, Converter={StaticResource BoolToVis}}"
                    Background="#161824"
                    CornerRadius="6"
                    Margin="0,6,0,0"
                    Padding="6,5"
                    BorderBrush="#293046"
                    BorderThickness="1">
                <StackPanel>
                    <!-- Drawer Header: Mode Toggle + Report Link -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Segmented Mode Pills (Live / Total) -->
                        <Border Grid.Column="0"
                                Background="#1A1D2E"
                                BorderBrush="#252A40"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Live"
                                        Command="{Binding SetInspectorLiveModeCommand}"
                                        FontSize="8.5"
                                        FontWeight="SemiBold"
                                        Padding="5,1"
                                        Cursor="Hand"
                                        BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProcessInspectorTotalMode}" Value="False">
                                                    <Setter Property="Background" Value="#312E81"/>
                                                    <Setter Property="Foreground" Value="#A5B4FC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Total"
                                        Command="{Binding SetInspectorTotalModeCommand}"
                                        FontSize="8.5"
                                        FontWeight="SemiBold"
                                        Padding="5,1"
                                        Cursor="Hand"
                                        BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProcessInspectorTotalMode}" Value="True">
                                                    <Setter Property="Background" Value="#312E81"/>
                                                    <Setter Property="Foreground" Value="#A5B4FC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Open Report Modal Button -->
                        <Button Grid.Column="2"
                                Content="↗ Report"
                                Command="{Binding OpenUsageReportCommand}"
                                Foreground="#38BDF8"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                ToolTip="Open Full Data Usage Report (Ctrl+Shift+R)">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" Padding="2,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Apps List -->
                    <ItemsControl ItemsSource="{Binding TopProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- App Icon -->
                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="14" Height="14" 
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- App Name -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,4,0">
                                        <TextBlock Text="{Binding ProcessName}" Foreground="#E2E8F0" FontSize="10" FontWeight="Medium"
                                                   MaxWidth="105" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Values: Main + Secondary -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayValueMain}" 
                                                   Foreground="{Binding DataContext.DownloadBrush, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding DisplayValueSecondary}" 
                                                   Foreground="{Binding DataContext.UploadBrush, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <TextBlock Text="No active application traffic"
                               Foreground="#475569"
                               FontSize="10"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               Margin="0,3"
                               Visibility="{Binding HasTopProcesses, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- 2. Ultra-Compact Single-Row Ribbon -->
            <Grid x:Name="CompactRibbonPanel"
                  Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVis}}"
                  VerticalAlignment="Center"
                  Height="20"
                  ToolTip="Double-click to expand (Ctrl+Shift+D)">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Download Speed -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,8,0">
                    <TextBlock Text="↓ " Foreground="{Binding DownloadBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DownloadSpeedText}" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"/>
                </StackPanel>

                <!-- Upload Speed -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="↑ " Foreground="{Binding UploadBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding UploadSpeedText}" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"/>
                </StackPanel>

                <!-- Right Side Badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Latency Badge -->
                    <Border x:Name="CompactPingBadgeBorder"
                            Background="#161A2B"
                            BorderBrush="#242B42"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="5,1"
                            Cursor="Hand"
                            ToolTipService.InitialShowDelay="50"
                            ToolTipService.ShowDuration="60000"
                            ToolTipService.BetweenShowDelay="0"
                            MouseLeftButtonDown="CompactPingBadge_MouseLeftButtonDown"
                            Visibility="{Binding ShowPingLatency, Converter={StaticResource BoolToVis}}">
                        <Border.ToolTip>
                            <ToolTip Style="{StaticResource NetworkHealthToolTipStyle}" Content="{Binding}"/>
                        </Border.ToolTip>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LatencyText}"
                                       Foreground="{Binding LatencyColorHex}"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" ⚠"
                                       Foreground="#F59E0B"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Visibility="{Binding HasBufferbloatWarning, Converter={StaticResource BoolToVis}}"
                                       Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Compact Data Cap Alert Indicator -->
                    <Border x:Name="CompactDataCapBadge"
                            Margin="4,0,0,0"
                            Padding="4,1"
                            Background="#25F59E0B"
                            BorderBrush="{Binding DataCapProgressBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Cursor="Hand"
                            ToolTipService.InitialShowDelay="50"
                            ToolTipService.ShowDuration="60000"
                            ToolTipService.BetweenShowDelay="0"
                            MouseLeftButtonDown="DataCapPanel_MouseLeftButtonDown"
                            Visibility="{Binding DataCapHasAlertWarning, Converter={StaticResource BoolToVis}}">
                        <Border.ToolTip>
                            <ToolTip Style="{StaticResource DataCapToolTipStyle}" Content="{Binding}"/>
                        </Border.ToolTip>
                        <TextBlock Text="⚠ Quota" Foreground="{Binding DataCapProgressBrush}" FontSize="9" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
